#!/bin/sh
# lapis-mcp — 지식 질의 MCP stdio 서버.
#
# 번들·node 탐색·임시 파일 처리는 전부 `scripts/bundle-run.sh`에 있다. 예전엔 래퍼마다
# 그 로직을 복제했는데, 사본이 늘면 그중 하나만 고쳐지고 나머지는 조용히 옛 버그를
# 유지한다(실제로 `lapis-eval`의 헤더 주석이 `lapis-mcp` 설명인 채로 남아 있었다).
set -e
HERE=$(cd "$(dirname "$0")" && pwd)
exec "$(dirname "$HERE")/scripts/bundle-run.sh" mcp "$HERE/server.ts" "$@"
